# Configuração do servidor (somente backend). Nunca incluir valores reais aqui.

# Rate limiting (por IP e por rota, janela em milissegundos)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Proxy de PDF (leitor e download)
PROXY_MAX_SIZE_BYTES=52428800
PROXY_TIMEOUT_MS=30000
# Whitelist opcional de sufixos de domínio permitidos no proxy.
# Vazio = qualquer domínio público https. Ex.: "arxiv.org,doaj.org"
PROXY_ALLOWED_HOST_SUFFIXES=

# Busca (providers OpenAlex, arXiv, DOAJ)
SEARCH_TIMEOUT_MS=15000
SEARCH_CACHE_TTL_MS=300000
# E-mail para o pool educado do OpenAlex (opcional, sem valor real aqui)
OPENALEX_MAILTO=
# Chave gratuita do Semantic Scholar (opcional; sem ela o limite é 100 req/5min por IP).
# Obtenha em https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=